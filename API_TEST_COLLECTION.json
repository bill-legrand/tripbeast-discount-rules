    {
      "name": "Dynamic Discount Rules",
      "item": [
        {
          "name": "Create Dynamic Discount - Value Based",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rule_name\": \"High_Value_Discount\",\n  \"discount_type\": \"dynamic\",\n  \"discount_percentage\": 10,\n  \"conditions\": [\n    {\n      \"field\": \"booking_value\",\n      \"operator\": \"greater_than\",\n      \"value\": 500\n    }\n  ],\n  \"channels\": [\"Channel_A\"],\n  \"products\": [\"PROD-001\"],\n  \"strike_through_enabled\": true,\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/discount-rules",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "discount-rules"]
            },
            "description": "Create a dynamic discount rule based on booking value"
          },
          "response": []
        },
        {
          "name": "Create Dynamic Discount - Multiple Conditions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rule_name\": \"Early_Bird_High_Value\",\n  \"discount_type\": \"dynamic\",\n  \"discount_percentage\": 15,\n  \"conditions\": [\n    {\n      \"field\": \"booking_value\",\n      \"operator\": \"greater_than\",\n      \"value\": 1000\n    },\n    {\n      \"field\": \"advance_booking_days\",\n      \"operator\": \"less_than\",\n      \"value\": 30\n    }\n  ],\n  \"condition_logic\": \"AND\",\n  \"channels\": [\"Channel_A\"],\n  \"products\": [\"PROD-001\"],\n  \"strike_through_enabled\": true,\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/discount-rules",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "discount-rules"]
            },
            "description": "Create a dynamic discount rule with multiple conditions"
          },
          "response": []
        }
      ]
    },
